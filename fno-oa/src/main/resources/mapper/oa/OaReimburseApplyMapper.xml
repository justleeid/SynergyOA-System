    <sql id="selectOaReimburseApplyVo">
        select id,tenant_id, user_id, dept_id, create_by, create_time, update_by, update_time, status, flow_key, flow_ins_id, apply_title, submit_time,
               billcode, remark, total_amt, bill_type, month, des, city, start_time, end_time, bill_count, img_url, days,  standard_subsidy, subsidy_amt, bill_amt
        from oa_reimburse_apply
    </sql>

    <select id="selectOaReimburseApplyList" parameterType="OaReimburseApply" resultMap="OaReimburseApplyResult">
        <include refid="selectOaReimburseApplyVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="tenantId != null "> and tenant_id = #{tenantId}</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="applyTitle != null  and applyTitle != ''"> and apply_title like concat('%', #{applyTitle}, '%')</if>
            <if test="billcode != null  and billcode != ''"> and billcode = #{billcode}</if>
            <if test="billType != null  and billType != ''"> and bill_type = #{billType}</if>
            <if test="month != null  and month != ''"> and month = #{month}</if>
            <if test="createBy != null and createBy != ''"> and create_by = #{createBy}</if>
        </where>
    </select>
    
    <select id="selectOaReimburseApplyById" parameterType="Long" resultMap="OaReimburseApplyoaReimburseFeeitemResult">
        select a.id,a.tenant_id, a.user_id, a.dept_id, a.create_by, a.create_time, a.update_by, a.update_time, a.status, a.flow_key, a.flow_ins_id, a.apply_title, a.submit_time,
