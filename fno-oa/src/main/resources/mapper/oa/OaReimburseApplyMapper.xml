        b.id as sub_id, b.create_by as sub_create_by, b.create_time as sub_create_time, b.update_by as sub_update_by, b.update_time as sub_update_time, b.remark as sub_remark,
        b.reimburse_id as sub_reimburse_id, b.item_amt as sub_item_amt, b.year as sub_year, b.month as sub_month, b.bill_type as sub_bill_type, b.bill_count as sub_bill_count,
