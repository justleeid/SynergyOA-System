<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fno.back.oa.mapper.OaBdSealMapper">
    
    <resultMap type="OaBdSeal" id="OaBdSealResult">
        <result property="id"    column="id"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="company" column="company" />
        <result property="img" column="img" />
        <result property="transparent" column="transparent" />
    </resultMap>

    <sql id="selectOaBdSealVo">
        select id,tenant_id, name, status, create_by, create_time, update_by, update_time, remark, company, img, transparent
        from oa_bd_seal
    </sql>

    <select id="selectOaBdSealList" parameterType="OaBdSeal" resultMap="OaBdSealResult">
        <include refid="selectOaBdSealVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="tenantId != null"> and tenant_id = #{tenantId}</if>
        </where>
    </select>
    
    <select id="selectOaBdSealById" parameterType="Long" resultMap="OaBdSealResult">
        <include refid="selectOaBdSealVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertOaBdSeal" parameterType="OaBdSeal">
        insert into oa_bd_seal
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="name != null">name,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>

            <if test="img != null">img,</if>
            <if test="company != null">company,</if>
            <if test="transparent != null">transparent,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="name != null">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>

            <if test="img != null">#{img},</if>
            <if test="company != null">#{company},</if>
            <if test="transparent != null">#{transparent},</if>
         </trim>
    </insert>

    <update id="updateOaBdSeal" parameterType="OaBdSeal">
        update oa_bd_seal
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>

            <if test="img != null">img = #{img},</if>
            <if test="company != null">company = #{company},</if>
            <if test="transparent != null">transparent = #{transparent},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOaBdSealById" parameterType="Long">
        delete from oa_bd_seal where id = #{id}
    </delete>

    <delete id="deleteOaBdSealByIds" parameterType="String">
        delete from oa_bd_seal where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>