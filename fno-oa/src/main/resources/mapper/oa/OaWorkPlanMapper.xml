<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fno.back.oa.mapper.OaWorkPlanMapper">
    
    <resultMap type="OaWorkPlan" id="OaWorkPlanResult">
        <result property="id"    column="id"    />
        <result property="planUserId"    column="plan_user_id"    />
        <result property="planUserNickname"    column="plan_user_nickname"    />
        <result property="title"    column="title"    />
        <result property="userId"    column="user_id"    />
        <result property="deptId"    column="dept_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="billType"    column="bill_type"    />
        <result property="billCode"    column="bill_code"    />
        <result property="flowKey"    column="flow_key"    />
        <result property="flowInsId"    column="flow_ins_id"    />
        <result property="submitTime"    column="submit_time"    />
        <result property="status"    column="status"    />
        <result property="tenantId" column="tenant_id" />
    </resultMap>

    <resultMap id="OaWorkPlanOaWorkPlanItemResult" type="OaWorkPlan" extends="OaWorkPlanResult">
        <collection property="oaWorkPlanItemList" notNullColumn="sub_id" javaType="java.util.List" resultMap="OaWorkPlanItemResult" />
    </resultMap>

    <resultMap type="OaWorkPlanItem" id="OaWorkPlanItemResult">
        <result property="id"    column="sub_id"    />
        <result property="planId"    column="sub_plan_id"    />
        <result property="groupName"    column="sub_group_name"    />
        <result property="detail"    column="sub_detail"    />
        <result property="remark"    column="sub_remark"    />
        <result property="dutyUserId"    column="sub_duty_user_id"    />
        <result property="dutyNickName"    column="sub_duty_nick_name"    />
        <result property="helpUserId"    column="sub_help_user_id"    />
        <result property="helpNickName"    column="sub_help_nick_name"    />
        <result property="startTime"    column="sub_start_time"    />
        <result property="endTime"    column="sub_end_time"    />
        <result property="schedule"    column="sub_schedule"    />
        <result property="makeObject"    column="sub_make_object"    />
        <result property="status"    column="sub_status"    />
    </resultMap>

    <sql id="selectOaWorkPlanVo">
        select p.id, p.plan_user_id,u.nick_name plan_user_nickname, p.title, p.user_id, p.dept_id, p.create_by, p.create_time, p.update_by, p.update_time, p.remark, p.bill_type,
               bill_code, p.flow_key, p.flow_ins_id, p.submit_time, p.status , p.tenant_id
        from oa_work_plan p left join sys_user u on p.create_by = u.user_id
    </sql>

    <select id="selectOaWorkPlanList" parameterType="OaWorkPlan" resultMap="OaWorkPlanResult">
        <include refid="selectOaWorkPlanVo"/>
        <where>  
            <if test="planUserId != null "> and p.plan_user_id = #{planUserId}</if>
            <if test="title != null  and title != ''"> and p.title like concat('%', #{title}, '%')</if>
            <if test="userId != null "> and p.user_id = #{userId}</if>
            <if test="deptId != null "> and p.dept_id = #{deptId}</if>
            <if test="billType != null  and billType != ''"> and p.bill_type = #{billType}</if>
            <if test="billCode != null  and billCode != ''"> and p.bill_code = #{billCode}</if>
            <if test="flowKey != null  and flowKey != ''"> and p.flow_key = #{flowKey}</if>
            <if test="flowInsId != null  and flowInsId != ''"> and p.flow_ins_id = #{flowInsId}</if>
            <if test="submitTime != null "> and p.submit_time = #{submitTime}</if>
            <if test="status != null  and status != ''"> and p.status = #{status}</if>
            <if test="tenantId != null"> and p.tenant_id = #{tenantId}</if>
        </where>
    </select>
    
    <select id="selectOaWorkPlanById" parameterType="Long" resultMap="OaWorkPlanOaWorkPlanItemResult">
        select a.id, a.plan_user_id, a.title, a.user_id, a.dept_id, a.create_by, a.create_time, a.update_by, a.update_time, a.remark, a.bill_type, a.bill_code,
               a.flow_key, a.flow_ins_id, a.submit_time, a.status,a.tenant_id ,
            b.id as sub_id, b.plan_id as sub_plan_id, b.group_name as sub_group_name, b.detail as sub_detail, b.remark as sub_remark, b.duty_user_id as sub_duty_user_id,
            b.duty_nick_name as sub_duty_nick_name, b.help_user_id as sub_help_user_id, b.help_nick_name as sub_help_nick_name, b.start_time as sub_start_time, b.end_time as sub_end_time,
            b.schedule as sub_schedule, b.make_object as sub_make_object, b.status as sub_status
        from oa_work_plan a
        left join oa_work_plan_item b on b.plan_id = a.id
        where a.id = #{id}
    </select>
        
    <insert id="insertOaWorkPlan" parameterType="OaWorkPlan" useGeneratedKeys="true" keyProperty="id">
        insert into oa_work_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planUserId != null">plan_user_id,</if>
            <if test="title != null">title,</if>
            <if test="userId != null">user_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="billType != null">bill_type,</if>
            <if test="billCode != null">bill_code,</if>
            <if test="flowKey != null">flow_key,</if>
            <if test="flowInsId != null">flow_ins_id,</if>
            <if test="submitTime != null">submit_time,</if>
            <if test="status != null">status,</if>
            <if test="tenantId != null">tenant_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planUserId != null">#{planUserId},</if>
            <if test="title != null">#{title},</if>
            <if test="userId != null">#{userId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="billType != null">#{billType},</if>
            <if test="billCode != null">#{billCode},</if>
            <if test="flowKey != null">#{flowKey},</if>
            <if test="flowInsId != null">#{flowInsId},</if>
            <if test="submitTime != null">#{submitTime},</if>
            <if test="status != null">#{status},</if>
            <if test="tenantId != null">#{tenantId},</if>
         </trim>
    </insert>

    <update id="updateOaWorkPlan" parameterType="OaWorkPlan">
        update oa_work_plan
        <trim prefix="SET" suffixOverrides=",">
            <if test="planUserId != null">plan_user_id = #{planUserId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="billType != null">bill_type = #{billType},</if>
            <if test="billCode != null">bill_code = #{billCode},</if>
            <if test="flowKey != null">flow_key = #{flowKey},</if>
            <if test="flowInsId != null">flow_ins_id = #{flowInsId},</if>
            <if test="submitTime != null">submit_time = #{submitTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOaWorkPlanById" parameterType="Long">
        delete from oa_work_plan where id = #{id}
    </delete>

    <delete id="deleteOaWorkPlanByIds" parameterType="String">
        delete from oa_work_plan where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteOaWorkPlanItemByPlanIds" parameterType="String">
        delete from oa_work_plan_item where plan_id in 
        <foreach item="planId" collection="array" open="(" separator="," close=")">
            #{planId}
        </foreach>
    </delete>

    <delete id="deleteOaWorkPlanItemByPlanId" parameterType="Long">
        delete from oa_work_plan_item where plan_id = #{planId}
    </delete>

    <insert id="batchOaWorkPlanItem">
        insert into oa_work_plan_item( id, plan_id, group_name, detail, remark, duty_user_id, duty_nick_name, help_user_id, help_nick_name, start_time, end_time, schedule, make_object, status) values
		<foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.planId}, #{item.groupName}, #{item.detail}, #{item.remark}, #{item.dutyUserId}, #{item.dutyNickName}, #{item.helpUserId}, #{item.helpNickName}, #{item.startTime}, #{item.endTime}, #{item.schedule}, #{item.makeObject}, #{item.status})
        </foreach>
    </insert>
</mapper>